# LeaseFlow AI local configuration
# Copy to .env for local overrides. Fixture mode works without an API key.

# --- Backend ---
APP_NAME=LeaseFlow AI
ENVIRONMENT=development
DATABASE_URL=sqlite:///./data/leaseflow.db
STORAGE_DIR=./data/uploads
MAX_UPLOAD_BYTES=10485760
CORS_ORIGINS=http://localhost:3000
DEMO_ACTOR=demo-reviewer

# fixture | openai
EXTRACTION_PROVIDER=fixture

# OpenAI-compatible provider (used only when EXTRACTION_PROVIDER=openai)
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
LLM_MAX_RESPONSE_BYTES=50000

# --- Frontend (browser) ---
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEMO_MODE=true
